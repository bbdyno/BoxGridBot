# .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.
# 텔레그램: BotFather 에서 새 봇 발급(다른 봇과 토큰 공유 금지 — 폴링 충돌)
TELEGRAM_BOT_TOKEN=
# 쉼표 구분. 본인 chat_id 만
TELEGRAM_CHAT_IDS=
# 실거래(live_lock: false) 시에만. 출금 권한 없는 키, IP 화이트리스트 권장
UPBIT_API_KEY=
UPBIT_SECRET=
BINANCE_API_KEY=
BINANCE_SECRET=
# 카카오 나에게 보내기(선택)
KAKAO_REST_API_KEY=
